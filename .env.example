# Required for contact email delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional: customize sender/subject prefix
CONTACT_FROM_EMAIL=DataViz Style Guide <onboarding@resend.dev>
CONTACT_SUBJECT_PREFIX=DVSG Contact

# Optional: spam protection via Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated allowlist for contact form Origin/Referer checks
ALLOWED_ORIGINS=https://www.datavizstyleguide.com,https://datavizstyleguide.com
