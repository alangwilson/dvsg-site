---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const homePage = await getEntry("pages", "home");

if (!homePage || homePage.data.kind !== "home") {
  throw new Error("Expected src/content/pages/home.md with kind: home.");
}

const authors = await getCollection("authors");
const authorsById = new Map(authors.map((author) => [author.data.authorId, author]));
const team = authors.slice(0, 4);

const highlights = (await getCollection("highlights")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const mostRecentTip = highlights[0];
const remainingTips = highlights.slice(1);
const randomTipFromRemaining =
  remainingTips.length > 0
    ? remainingTips[Math.floor(Math.random() * remainingTips.length)]
    : undefined;
const tipCards = [mostRecentTip, randomTipFromRemaining].filter(Boolean);
const tipNumbersBySlug = new Map(
  highlights.map((entry, index) => [entry.id, `№ ${String(highlights.length - index).padStart(2, "0")}`])
);

const resources = (await getCollection("resources")).sort((a, b) => a.id.localeCompare(b.id));
const exampleResources = resources.filter((item) => item.data.homeCategory === "examples").slice(0, 5);
const videoResources = resources.filter((item) => item.data.homeCategory === "videos").slice(0, 5);
const otherResources = resources.filter((item) => item.data.homeCategory === "other").slice(0, 5);
const pathname = Astro.url.pathname;

const isNavActive = (section: "tips" | "resources" | "examples" | "about"): boolean => {
  if (section === "tips") {
    return pathname.startsWith("/tips/") || pathname.startsWith("/highlights/");
  }

  if (section === "resources") {
    return pathname.startsWith("/resources/") || pathname.startsWith("/videos/");
  }

  if (section === "examples") {
    return pathname.startsWith("/examples/");
  }

  return pathname.startsWith("/about/") || pathname.startsWith("/contact/");
};
---

<BaseLayout
  title="Data Visualization Style Guides"
  description={homePage.data.heroIntro}
  showHeader={false}
  showFooter={false}
>
  <div class="home-scene">
    <div class="home-frame">
      <header class="home-topbar" aria-label="Site header">
        <a class="brand-lockup" href="/" aria-label="Data Visualization Style Guides home">
          <img
            class="header-logo header-logo-large"
            src="/images/design/logos/DVSG-logo-large-dark.svg"
            width="433"
            height="77"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
          />
          <img
            class="header-logo header-logo-small"
            src="/images/design/logos/DVSG-logo-small-dark.svg"
            width="187"
            height="77"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
          />
        </a>

        <details class="mobile-menu">
          <summary class="menu-toggle" aria-label="Open menu">
            <svg
              class="menu-toggle-icon"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3" y="6" width="18" height="2"></rect>
              <rect x="3" y="11" width="18" height="2"></rect>
              <rect x="3" y="16" width="18" height="2"></rect>
            </svg>
          </summary>
          <nav class="mobile-nav" aria-label="Primary mobile">
            <a href="/tips/" aria-current={isNavActive("tips") ? "page" : undefined}>Tips</a>
            <a href="/resources/" aria-current={isNavActive("resources") ? "page" : undefined}>Resources</a>
            <a href="/examples/" aria-current={isNavActive("examples") ? "page" : undefined}>Examples</a>
            <a href="/about/" aria-current={isNavActive("about") ? "page" : undefined}>About</a>
          </nav>
        </details>

        <nav class="home-nav" aria-label="Primary">
          <a href="/tips/" aria-current={isNavActive("tips") ? "page" : undefined}>Tips</a>
          <a href="/resources/" aria-current={isNavActive("resources") ? "page" : undefined}>Resources</a>
          <a href="/examples/" aria-current={isNavActive("examples") ? "page" : undefined}>Examples</a>
          <a href="/about/" aria-current={isNavActive("about") ? "page" : undefined}>About</a>
        </nav>
      </header>

      <div class="home-paper">
        <section class="home-intro" aria-label="Introduction">
          <p>{homePage.data.heroIntro}</p>
        </section>

        <section class="tips-row" aria-label="Latest tips">
          {tipCards.map((entry, index) => {
            const tipAuthor = authorsById.get(entry.data.author);
            const tipAuthorName = tipAuthor?.data.name ?? "DataViz Style Guides";

            return (
              <article class="tip-card" aria-label={`Tip ${index + 1}`}>
                <div class="tip-card-top">
                  <span class="tip-badge"></span>
                  <span class="tip-number">{tipNumbersBySlug.get(entry.id) ?? "№ 00"}</span>
                </div>
                <h2>
                  <a href={`/tips/${entry.id}/`}>{entry.data.title}</a>
                </h2>
                <p class="tip-author">
                  {tipAuthor?.data.headshot ? (
                    <img
                      class="tip-author-image"
                      src={tipAuthor.data.headshot}
                      width="64"
                      height="64"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="tip-author-icon" aria-hidden="true"></span>
                  )}
                  {tipAuthorName}
                </p>
              </article>
            );
          })}
          <a class="tip-card tip-card-cta" href="/tips/">
            <span>Read more tips ›</span>
          </a>
        </section>

        <section class="getting-started" aria-label="Getting started">
          <h2>{homePage.data.gettingStartedHeading}</h2>
          <div class="getting-grid">
            {homePage.data.gettingStartedItems.map((item) => (
              <article class="guide-step">
                <p class="guide-step-label">
                  <span>{item.number}</span> {item.title}
                </p>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
          <a class="dv-button" href="/tips/">{homePage.data.gettingStartedCtaLabel}</a>
        </section>

        <section class="resource-columns" aria-label="Resources and examples">
          <article class="resource-column">
            <h3>{homePage.data.examplesHeading}</h3>
            <ul>
              {exampleResources.map((item) => (
                <li>
                  <a href={item.data.url} target="_blank" rel="noreferrer">{item.data.title}</a>
                  {item.data.byline && <p>{item.data.byline}</p>}
                </li>
              ))}
            </ul>
            <a class="dv-button" href="/examples/">{homePage.data.examplesCtaLabel}</a>
          </article>

          <article class="resource-column">
            <h3>{homePage.data.videosHeading}</h3>
            <ul>
              {videoResources.map((item) => (
                <li>
                  <a href={`/resources/${item.id}/`}>{item.data.title}</a>
                  {item.data.byline && <p>{item.data.byline}</p>}
                </li>
              ))}
            </ul>
            <a class="dv-button" href="/resources/">{homePage.data.videosCtaLabel}</a>
          </article>

          <article class="resource-column">
            <h3>{homePage.data.otherResourcesHeading}</h3>
            <ul>
              {otherResources.map((item) => (
                <li>
                  <a href={`/resources/${item.id}/`}>{item.data.title}</a>
                  {item.data.byline && <p>{item.data.byline}</p>}
                </li>
              ))}
            </ul>
            <a class="dv-button" href="/resources/">{homePage.data.otherResourcesCtaLabel}</a>
          </article>
        </section>

        <section class="who-we-are" aria-label="Team">
          <h2>{homePage.data.whoWeAreHeading}</h2>
          <div class="people-grid">
            {team.map((author) => (
              <article class="person-card">
                <div class:list={["person-avatar", { "has-image": Boolean(author.data.headshot) }]} aria-hidden="true">
                  {author.data.headshot && (
                    <img
                      class="person-avatar-image"
                      src={author.data.headshot}
                      width="160"
                      height="160"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <p>
                  {author.data.linkedin ? (
                    <a href={author.data.linkedin} target="_blank" rel="noreferrer">
                      {author.data.name}
                    </a>
                  ) : (
                    <strong>{author.data.name}</strong>
                  )}{" "}
                  {author.data.shortBio ?? author.data.bio ?? ""}
                </p>
              </article>
            ))}
          </div>
        </section>
      </div>

      <footer class="home-footer">
        <div class="footer-brand">
          <img
            class="footer-logo"
            src="/images/design/logos/DVSG-logo-footer.svg"
            width="150"
            height="141"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
        </div>

        <nav class="footer-links" aria-label="Footer">
          <a href="/resources/">Resources</a>
          <a href="/tips/">Tips</a>
          <a href="/examples/">Examples</a>
          <a href="/about/">About</a>
          <a href="/about/#contact-form">Contact</a>
        </nav>

        <div class="footer-cta">
          <p>{homePage.data.footerPrompt}</p>
          <a class="dv-button" href="/contribute/">{homePage.data.contributeLabel}</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
