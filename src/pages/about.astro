---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const aboutContent = await getEntry("pages", "contact");

if (!aboutContent || aboutContent.data.kind !== "contact") {
  throw new Error("Expected src/content/pages/contact.md with kind: contact.");
}

const { Content } = await aboutContent.render();
const team = (await getCollection("authors")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
// Contact form is temporarily hidden until the Resend backend is configured.
// Flip to true (and set the Resend env vars in Vercel) to restore it.
const SHOW_CONTACT_FORM = false;
---

<BaseLayout title="About | DataViz Style Guide" description="Learn about the team and contact DataViz Style Guide.">
  <article class="contact-scene about-scene">
    <section class="contact-shell">
      <div class="contact-paper">
        <header class="contact-intro">
          <h1>About Data Visualization Style Guides</h1>
        </header>

        <div class="contact-grid about-grid">
          <div class="contact-prose prose">
            <Content />
          </div>
          <aside class="about-photo-column" aria-label="Alan and Amy at Outlier conference">
            <figure class="about-photo">
              <img
                src="/images/uploads/about/alan-amy-outlier-2025.jpeg"
                width="828"
                height="1269"
                alt="A picture of Alan and Amy at the Outlier conference in 2025 with a slide from the talk they gave with Max and Jon in the background."
                loading="lazy"
                decoding="async"
              />
              <figcaption>Amy and Alan at the 2025 Outlier Conference in Miami</figcaption>
            </figure>
          </aside>
        </div>

        <section class="who-we-are" aria-label="Team">
          <h2>Who we are</h2>
          <div class="people-grid about-team-grid">
            {team.map((author) => {
              const aboutBio = author.data.longBio ?? author.data.shortBio ?? author.data.bio ?? "";

              return (
                <article class="person-card about-team-card">
                  <div class:list={["person-avatar", { "has-image": Boolean(author.data.headshot) }]} aria-hidden="true">
                    {author.data.headshot && (
                      <img
                        class="person-avatar-image"
                        src={author.data.headshot}
                        width="160"
                        height="160"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </div>
                  <p>
                    {author.data.linkedin ? (
                      <a href={author.data.linkedin} target="_blank" rel="noreferrer">
                        {author.data.name}
                      </a>
                    ) : (
                      <strong>{author.data.name}</strong>
                    )}{" "}
                    {aboutBio}
                  </p>
                </article>
              );
            })}
          </div>
        </section>

        {SHOW_CONTACT_FORM ? (
        <section id="contact-form" class="contact-aside about-contact-form" aria-label="Contact form">
          <h2>Contact us</h2>
          <p class="contact-form-intro">
            Let us know if there&apos;s other resources we should add or if you&apos;re interested in our work.
          </p>

          <form class="contact-form" data-contact-form novalidate>
            <div class="contact-form-grid">
              <div class="contact-form-field contact-form-field-wide">
                <label for="contact-reason">Reason for Contact</label>
                <select id="contact-reason" name="reason" required>
                  <option value="">Select an option</option>
                  <option value="Help creating data viz style guide">Help creating data viz style guide</option>
                  <option value="Consluting or speaking engagement">Consluting or speaking engagement</option>
                  <option value="General inquiry">General inquiry</option>
                </select>
              </div>

              <div class="contact-form-name-grid contact-form-field-wide">
                <div class="contact-form-field">
                  <label for="contact-first-name">First name</label>
                  <input id="contact-first-name" name="firstName" type="text" autocomplete="given-name" required />
                </div>
                <div class="contact-form-field">
                  <label for="contact-last-name">Last name</label>
                  <input id="contact-last-name" name="lastName" type="text" autocomplete="family-name" required />
                </div>
              </div>

              <div class="contact-form-field contact-form-field-wide">
                <label for="contact-email">Email</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required />
              </div>

              <div class="contact-form-field contact-form-field-wide">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" rows={6} required></textarea>
              </div>
            </div>

            <div class="contact-form-honeypot-wrap" aria-hidden="true">
              <label for="contact-website">Website</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="formLoadedAt" value="" />

            {turnstileSiteKey && (
              <div class="contact-form-turnstile">
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
              </div>
            )}

            <div class="contact-form-actions">
              <button class="dv-button" type="submit" data-contact-form-submit>
                Send
              </button>
              <p class="contact-form-status" data-contact-form-status role="status" aria-live="polite"></p>
            </div>
          </form>
        </section>
        ) : (
        <section id="contact-form" class="contact-aside about-contact-form" aria-label="Contact">
          <h2>Contact us</h2>
          <p class="contact-form-intro">Our contact form is temporarily unavailable. Please check back soon.</p>
        </section>
        )}
      </div>
    </section>
  </article>

  {turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  <script>
    import { initContactForm } from "../scripts/contact-form-client";

    initContactForm({
      formSelector: "[data-contact-form]",
      statusSelector: "[data-contact-form-status]",
      submitSelector: "[data-contact-form-submit]",
      successFallbackMessage: "Thank you for messaging us! Your email was sent to the team.",
      genericErrorMessage: "Unable to send your message right now. Please try again.",
      unavailableErrorMessage:
        "Form backend is unavailable in this local server mode. Use `vercel dev` or test on deployed Vercel."
    });
  </script>
</BaseLayout>
