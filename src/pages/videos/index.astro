---
const targetUrl = "/resources/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={targetUrl} />
    <title>Redirecting to Resources</title>
  </head>
  <body>
    <p>Redirecting to <a href={targetUrl}>Resources</a>...</p>
    <script is:inline>
      window.location.replace("/resources/");
    </script>
  </body>
</html>
