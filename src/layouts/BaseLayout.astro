---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@styles/base.css";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  mainClass?: string;
  robots?: string;
}

const {
  title = "Data Visualization Style Guide",
  description = "Research-backed patterns and examples for strong data storytelling.",
  showHeader = true,
  showFooter = true,
  mainClass = "",
  robots
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Abyssinica+SIL&family=Alexandria:wght@400;500;600;700;800&family=Barlow+Condensed:wght@500;600&family=EB+Garamond:ital,wght@0,400;0,600;1,400;1,500;1,700&family=Playfair+Display:ital,wght@0,300;0,400;0,600;0,700;0,900;1,300;1,400;1,600;1,700&family=Playfair:ital,wght@0,500;0,600;1,400;1,500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    {showHeader || showFooter ? (
      <div class="home-scene interior-page-scene">
        <div class="home-frame">
          {showHeader && <Header />}
          <main class={`site-main ${mainClass}`.trim()}>
            <slot />
          </main>
          {showFooter && <Footer />}
        </div>
      </div>
    ) : (
      <main class={`site-main ${mainClass}`.trim()}>
        <slot />
      </main>
    )}
  </body>
</html>
