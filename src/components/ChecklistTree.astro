---
export interface ChecklistNode {
  label: string;
  children?: ChecklistNode[];
}

interface Props {
  nodes: ChecklistNode[];
  level?: number;
}

const { nodes, level = 0 } = Astro.props;
---

<ul class:list={["checklist-tree", level === 0 && "checklist-tree-root"]} data-level={level}>
  {nodes.map((node) => (
    <li class="checklist-node">
      <div class="checklist-label">
        {level === 0 && <span class="checklist-marker" aria-hidden="true"></span>}
        <span class="checklist-text">{node.label}</span>
      </div>
      {node.children && node.children.length > 0 && (
        <Astro.self nodes={node.children} level={level + 1} />
      )}
    </li>
  ))}
</ul>

<style>
  .checklist-tree {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Top level: the six sections, each with a numbered marker. */
  .checklist-tree-root {
    counter-reset: section;
    display: grid;
    gap: 1.4rem;
    margin-top: 0.5rem;
  }

  .checklist-tree-root > .checklist-node {
    counter-increment: section;
  }

  .checklist-node {
    position: relative;
    padding: 0.22rem 0;
  }

  .checklist-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .checklist-text {
    font-family: var(--font-prose);
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.35;
  }

  /* Section headings */
  .checklist-tree-root > .checklist-node > .checklist-label .checklist-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--color-ink-blue);
  }

  /* First sub-level (e.g. Color, Typography, Axis) gets a touch more weight. */
  .checklist-tree[data-level="1"] > .checklist-node > .checklist-label .checklist-text {
    color: var(--color-ink);
    font-weight: 600;
    font-size: 1.12rem;
  }

  /* Numbered gold marker, echoing the TIP badge. */
  .checklist-marker {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.28rem;
    background: #c7b37d;
    color: var(--color-paper-contrast);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.2rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .checklist-tree-root > .checklist-node > .checklist-label > .checklist-marker::before {
    content: counter(section);
  }

  /* Nested lists: indent and draw connector rails. */
  .checklist-tree .checklist-tree {
    margin-left: 0.95rem;
    padding-left: 1.25rem;
    margin-top: 0.15rem;
  }

  /* Elbow: vertical drop + rounded corner + horizontal tick to each node. */
  .checklist-tree .checklist-tree > .checklist-node::before {
    content: "";
    position: absolute;
    top: -0.05rem;
    left: -1.25rem;
    width: 1rem;
    height: 0.95rem;
    border-left: 1.5px solid var(--color-border);
    border-bottom: 1.5px solid var(--color-border);
    border-bottom-left-radius: 7px;
  }

  /* Rail continuation for every node except the last, joining the next sibling. */
  .checklist-tree .checklist-tree > .checklist-node:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0.9rem;
    left: -1.25rem;
    bottom: -0.37rem;
    border-left: 1.5px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .checklist-tree-root > .checklist-node > .checklist-label .checklist-text {
      font-size: 1.3rem;
    }
  }
</style>
